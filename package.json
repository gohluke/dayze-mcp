{
  "name": "dayze-mcp",
  "version": "1.42.0",
  "description": "MCP client integrations and a tested stdio adapter for Dayze: personal life context over hosted OAuth, with explicit API-key support for local clients.",
  "homepage": "https://dayze.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/gohluke/dayze-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gohluke/dayze-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "dayze-mcp": "./server.mjs"
  },
  "scripts": {
    "start": "node ./server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/adapter.mjs && node --check lib/upstream.mjs && node --check scripts/check-package.mjs && node scripts/check-package.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "keywords": [
    "life-context",
    "mcp",
    "model-context-protocol",
    "personal-crm",
    "relationship-intelligence",
    "ai-agents",
    "dayze",
    "oauth",
    "streamable-http",
    "chatgpt",
    "claude",
    "openai",
    "gemini",
    "notable-people"
  ],
  "mcpName": "io.github.gohluke/dayze-mcp",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "server.mjs",
    "lib/",
    "README.md",
    "LICENSE"
  ]
}
